    <alpha android:fromAlpha="1.0" android:toAlpha="0.0" android:duration="340" />
    <scale android:fromXScale="1.0" android:toXScale="0.94"
        android:fromYScale="1.0" android:toYScale="0.94"
        android:pivotX="50%" android:pivotY="88%" android:duration="360" />
