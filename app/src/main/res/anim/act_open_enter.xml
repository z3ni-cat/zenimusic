<?xml version="1.0" encoding="utf-8"?>
<!-- Pemutar membesar dari pil mini player (v3.8.0 "Smooth") -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:anim/decelerate_interpolator">
    <alpha android:fromAlpha="0.0" android:toAlpha="1.0" android:duration="380" />
    <scale android:fromXScale="0.92" android:toXScale="1.0"
        android:fromYScale="0.92" android:toYScale="1.0"
        android:pivotX="50%" android:pivotY="88%" android:duration="420" />
    <translate android:fromYDelta="4%" android:toYDelta="0" android:duration="420" />
</set>
